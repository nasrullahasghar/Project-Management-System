# Postgres connection (same DB as the .NET backend)
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/projectmanagementdb

# JWT settings (mirrors appsettings.json -> "Jwt" section)
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ISSUER=ProjectManagementApi
JWT_AUDIENCE=ProjectManagementApiUsers
JWT_EXPIRY_MINUTES=60

# CORS - Angular dev server
FRONTEND_ORIGIN=http://localhost:4200
